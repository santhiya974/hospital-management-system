# Server
PORT=5000
NODE_ENV=production

# MongoDB (get this from MongoDB Atlas after creating a free cluster)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/hospital_management?retryWrites=true&w=majority

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_generated_64_byte_hex_secret
JWT_EXPIRE=7d

# Cloudinary (from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer (optional — only needed if email notifications are used)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Client (comma-separated allowed origins — add your Vercel URL after frontend deploys)
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app